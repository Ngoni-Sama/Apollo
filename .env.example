# Copy to .env and fill in. Never commit .env.

# --- ASR ---
# faster-whisper | whisper.cpp
WHISPER_BACKEND=faster-whisper
# faster-whisper model name (tiny.en, base.en, small.en, medium.en, large-v3, large-v3-turbo)
WHISPER_MODEL=small.en
# auto | cpu | cuda
WHISPER_DEVICE=auto
# whisper.cpp: path to the built CLI and a ggml model file
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# where model weights are cached (downloaded once)
MODEL_CACHE_DIR=./models

# --- yt-dlp ---
# Either a Netscape cookies.txt path, or a browser name (chrome, firefox, safari, ...)
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
# JavaScript runtime(s) for YouTube extraction, comma-separated (deno, node, bun, quickjs)
YTDLP_JS_RUNTIMES=deno

# --- TikTok ---
# ms_token cookie value from a logged-in tiktok.com browser session (improves success rate)
TIKTOK_MS_TOKEN=
# Optional explicit Chromium path for Playwright
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# true | false
TIKTOK_HEADLESS=true

# --- Throttle ---
SLEEP_SEC=2.0
